{
  "info": {
    "name": "Course Feedback System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "courseId", "value": "" }
  ],
  "item": [
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"rahul@test.com\",\n  \"password\": \"123456\"\n}" }
      }
    },
    {
      "name": "Register Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"admin\"\n}" }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"rahul@test.com\",\n  \"password\": \"123456\"\n}" }
      }
    },
    {
      "name": "Add Course (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/courses",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Data Structures\",\n  \"code\": \"CS201\",\n  \"description\": \"Arrays, trees, graphs\"\n}" }
      }
    },
    {
      "name": "Get Courses",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/courses"
      }
    },
    {
      "name": "Mark Course Completed (student)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/complete"
      }
    },
    {
      "name": "Submit Feedback (student)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/courses/{{courseId}}/feedback",
        "body": { "mode": "raw", "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Good course, well explained\"\n}" }
      }
    },
    {
      "name": "Average Rating of a Course (admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/average-rating"
      }
    },
    {
      "name": "Average Rating of All Courses (admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/courses/average-ratings"
      }
    }
  ]
}
